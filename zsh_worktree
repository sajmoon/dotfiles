# =============================================================================
# Git Worktree Helpers — wt
# =============================================================================
#
# A single `wt` command for managing git worktrees. Worktrees are created
# inside .worktrees/<name> at the repo root, and .worktrees/ is in
# gitignore_global so it won't pollute any repo's history.
#
# Subcommands:
#   wt new [name]    Create a worktree + branch and cd into it.
#                    Omit name to get a timestamped throwaway: tmp-YYYYMMDDHHMMSS
#   wt ls            List all worktrees for the current repo.
#   wt root          cd to the main worktree (the original repo root).
#   wt rm <name>     Remove worktree and force-delete its branch.
#                    Force-delete (-D) is intentional — worktree branches are
#                    typically unmerged by design.
#   wt handoff       From inside a worktree: remove it and check out its branch
#                    in the main worktree. Use when you want to continue work
#                    outside the worktree sandbox.
#
# Tab completion:
#   wt <TAB>         → new / ls / root / rm
#   wt rm <TAB>      → existing worktree names from .worktrees/
# =============================================================================

wt() {
  local cmd="$1"

  if [[ -z "$cmd" ]]; then
    echo "Usage: wt <new|ls|root|rm|handoff> [name]"
    return 1
  fi

  case "$cmd" in

    new)
      local name="${2:-tmp-$(date +%Y%m%d%H%M%S)}"
      local root
      root=$(git rev-parse --show-toplevel 2>/dev/null) || {
        echo "wt: not inside a git repository"
        return 1
      }
      local dir="$root/.worktrees/$name"

      git worktree add -b "$name" "$dir" || return 1
      echo "→ $dir"
      cd "$dir"
      ;;

    ls)
      git worktree list
      ;;

    root)
      local main
      main=$(git worktree list | awk 'NR==1 {print $1}') || {
        echo "wt: not inside a git repository"
        return 1
      }
      cd "$main"
      ;;

    rm)
      local name="$2"
      if [[ -z "$name" ]]; then
        echo "Usage: wt rm <name>"
        return 1
      fi

      local root
      root=$(git rev-parse --show-toplevel 2>/dev/null) || {
        echo "wt: not inside a git repository"
        return 1
      }

      git worktree remove "$root/.worktrees/$name" && git branch -D "$name"
      ;;

    handoff)
      local main
      main=$(git worktree list 2>/dev/null | awk 'NR==1 {print $1}') || {
        echo "wt: not inside a git repository"
        return 1
      }

      local root
      root=$(git rev-parse --show-toplevel 2>/dev/null)
      local worktrees_base="$main/.worktrees"

      if [[ "$root" != "$worktrees_base/"* ]]; then
        echo "wt: not inside a managed worktree (.worktrees/)"
        return 1
      fi

      local name="${root#$worktrees_base/}"
      local branch
      branch=$(git rev-parse --abbrev-ref HEAD)

      cd "$main" || return 1
      git worktree remove "$worktrees_base/$name" || return 1
      git checkout "$branch"
      echo "→ handed off '$branch' to main worktree"
      ;;

    *)
      echo "wt: unknown subcommand '$cmd'"
      echo "Usage: wt <new|ls|root|rm|handoff> [name]"
      return 1
      ;;

  esac
}

# =============================================================================
# Completion
# =============================================================================

_wt() {
  local state
  _arguments \
    '1: :->cmd' \
    '*: :->args'

  case $state in
    cmd)
      _values 'subcommand' \
        'new[create a new worktree and branch]' \
        'ls[list all worktrees]' \
        'root[cd to the main worktree]' \
        'rm[remove a worktree and its branch]' \
        'handoff[remove current worktree and check out its branch in main]'
      ;;
    args)
      if [[ $words[2] == rm ]]; then
        local root
        root=$(git rev-parse --show-toplevel 2>/dev/null) || return
        local dir="$root/.worktrees"
        [[ -d "$dir" ]] && _values 'worktree' "$dir"/*(N:t)
      fi
      ;;
  esac
}

compdef _wt wt
