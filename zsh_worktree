# =============================================================================
# Git Worktree Helpers — wt
# =============================================================================
#
# A single `wt` command for managing git worktrees. Worktrees are created
# inside .worktrees/<name> at the repo root, and .worktrees/ is in
# gitignore_global so it won't pollute any repo's history.
#
# Subcommands:
#   wt new [name]    Create a worktree + branch and cd into it.
#                    Omit name to get a timestamped throwaway: tmp-YYYYMMDDHHMMSS
#   wt go <name>     cd into an existing worktree (you move, work stays).
#   wt ls            List all worktrees for the current repo.
#   wt root          cd to the main worktree (the original repo root).
#   wt rm [-f] <name|path>
#                    Remove worktree and force-delete its branch. Accepts a
#                    .worktrees/ name, an absolute/relative path, or any
#                    basename that uniquely identifies a worktree in the list.
#                    Pass -f/--force to remove a worktree with modified or
#                    untracked files. Branch is always force-deleted (-D) —
#                    worktree branches are typically unmerged by design.
#   wt done [-f]     From inside a worktree: cd to root, then remove the
#                    current worktree and force-delete its branch (same as
#                    `wt rm` on the worktree you're standing in). Use when
#                    you're finished with a worktree and want it gone.
#   wt take <name>   From root: remove a named worktree and check out its
#                    branch here. Refuses if root has uncommitted changes.
#   wt send [name]   Dual-mode:
#                    • From root: move current branch to a new worktree, then
#                      return root to the default branch. Name defaults to the
#                      branch name. Refuses if root has uncommitted changes.
#                    • From a worktree: remove it and check out its branch in
#                      the main worktree (formerly "handoff").
#
# Tab completion:
#   wt <TAB>              → subcommands
#   wt go/rm/take <TAB>   → existing worktree names from .worktrees/
# =============================================================================

_wt_main() {
  git worktree list 2>/dev/null | awk 'NR==1 {print $1}'
}

_wt_root() {
  git rev-parse --show-toplevel 2>/dev/null
}

_wt_default_branch() {
  git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||' || echo main
}

wt() {
  local cmd="$1"

  if [[ -z "$cmd" ]]; then
    echo "Usage: wt <new|go|ls|root|rm|done|take|send> [name]"
    return 1
  fi

  case "$cmd" in

    new)
      local name="${2:-tmp-$(date +%Y%m%d%H%M%S)}"
      local main
      main=$(_wt_main) || { echo "wt: not inside a git repository"; return 1 }
      local dir="$main/.worktrees/$name"

      git worktree add -b "$name" "$dir" || return 1
      echo "→ $dir"
      cd "$dir"
      ;;

    go)
      local name="$2"
      if [[ -z "$name" ]]; then
        echo "Usage: wt go <name>"
        return 1
      fi

      local main
      main=$(_wt_main) || { echo "wt: not inside a git repository"; return 1 }
      local wt_dir="$main/.worktrees/$name"

      if [[ ! -d "$wt_dir" ]]; then
        echo "wt: worktree '$name' not found"
        return 1
      fi

      cd "$wt_dir"
      ;;

    ls)
      git worktree list
      ;;

    root)
      local main
      main=$(_wt_main) || { echo "wt: not inside a git repository"; return 1 }
      cd "$main"
      ;;

    rm)
      local force=0
      shift
      while [[ "$1" == -* ]]; do
        case "$1" in
          -f|--force) force=1; shift ;;
          *) echo "wt rm: unknown flag '$1'"; return 1 ;;
        esac
      done
      local arg="$1"
      if [[ -z "$arg" ]]; then
        echo "Usage: wt rm [-f|--force] <name|path>"
        return 1
      fi

      local main
      main=$(_wt_main) || { echo "wt: not inside a git repository"; return 1 }

      # Resolve arg → worktree path: try as path, then .worktrees/$arg, then basename match
      local target=""
      if [[ -d "$arg" ]]; then
        target=$(cd "$arg" && git rev-parse --show-toplevel 2>/dev/null)
      elif [[ -d "$main/.worktrees/$arg" ]]; then
        target="$main/.worktrees/$arg"
      else
        local matches=()
        local line p
        while IFS= read -r line; do
          p="${line%% *}"
          [[ "${p:t}" == "$arg" ]] && matches+=("$p")
        done < <(git worktree list)
        if [[ ${#matches[@]} -eq 0 ]]; then
          echo "wt: worktree '$arg' not found"
          return 1
        elif [[ ${#matches[@]} -gt 1 ]]; then
          echo "wt: '$arg' is ambiguous, matches:"
          printf '  %s\n' "${matches[@]}"
          return 1
        fi
        target="${matches[1]}"
      fi

      if [[ "$target" == "$main" ]]; then
        echo "wt: refusing to remove root worktree"
        return 1
      fi

      local branch
      branch=$(git -C "$target" rev-parse --abbrev-ref HEAD 2>/dev/null)

      local -a remove_args=(remove)
      (( force )) && remove_args+=(--force)
      remove_args+=("$target")
      git worktree "${remove_args[@]}" || return 1
      if [[ -n "$branch" && "$branch" != "HEAD" ]]; then
        git branch -D "$branch" 2>/dev/null
      fi
      ;;

    done)
      local force=0
      shift
      while [[ "$1" == -* ]]; do
        case "$1" in
          -f|--force) force=1; shift ;;
          *) echo "wt done: unknown flag '$1'"; return 1 ;;
        esac
      done

      local main
      main=$(_wt_main) || { echo "wt: not inside a git repository"; return 1 }
      local root
      root=$(_wt_root)

      if [[ "$root" != "$main/.worktrees/"* ]]; then
        echo "wt: not inside a worktree (use 'wt rm <name>' from root)"
        return 1
      fi

      local target="$root"
      local branch
      branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

      cd "$main" || return 1

      local -a remove_args=(remove)
      (( force )) && remove_args+=(--force)
      remove_args+=("$target")
      if ! git worktree "${remove_args[@]}"; then
        cd "$target"
        return 1
      fi
      if [[ -n "$branch" && "$branch" != "HEAD" ]]; then
        git branch -D "$branch" 2>/dev/null
      fi
      echo "→ done with '${target:t}', back at root"
      ;;

    take)
      local name="$2"
      if [[ -z "$name" ]]; then
        echo "Usage: wt take <name>"
        return 1
      fi

      local main
      main=$(_wt_main) || { echo "wt: not inside a git repository"; return 1 }
      local root
      root=$(_wt_root)

      if [[ "$root" != "$main" ]]; then
        echo "wt: must be run from the main worktree"
        return 1
      fi

      if [[ -n "$(git status --porcelain)" ]]; then
        echo "wt: uncommitted changes in root — stash or commit first"
        return 1
      fi

      local wt_dir="$main/.worktrees/$name"
      if [[ ! -d "$wt_dir" ]]; then
        echo "wt: worktree '$name' not found"
        return 1
      fi

      local branch
      branch=$(git -C "$wt_dir" rev-parse --abbrev-ref HEAD)

      git worktree remove "$wt_dir" || return 1
      git checkout "$branch"
      echo "→ took '$branch' into root"
      ;;

    send)
      local main
      main=$(_wt_main) || { echo "wt: not inside a git repository"; return 1 }
      local root
      root=$(_wt_root)

      if [[ "$root" == "$main/.worktrees/"* ]]; then
        # FROM WORKTREE → root
        local name="${root#$main/.worktrees/}"
        local branch
        branch=$(git rev-parse --abbrev-ref HEAD)

        cd "$main" || return 1
        git worktree remove "$main/.worktrees/$name" || return 1
        git checkout "$branch"
        echo "→ sent '$branch' to root"
      else
        # FROM ROOT → new worktree
        if [[ -n "$(git status --porcelain)" ]]; then
          echo "wt: uncommitted changes — stash or commit first"
          return 1
        fi

        local branch
        branch=$(git rev-parse --abbrev-ref HEAD)
        local name="${2:-$branch}"
        local wt_dir="$main/.worktrees/$name"
        local default_branch
        default_branch=$(_wt_default_branch)

        git checkout "$default_branch" || return 1
        git worktree add "$wt_dir" "$branch" || return 1
        echo "→ sent '$branch' to worktree, root is now on '$default_branch'"
      fi
      ;;

    *)
      echo "wt: unknown subcommand '$cmd'"
      echo "Usage: wt <new|go|ls|root|rm|take|send> [name]"
      return 1
      ;;

  esac
}

# =============================================================================
# Completion
# =============================================================================

_wt() {
  local state
  _arguments \
    '1: :->cmd' \
    '*: :->args'

  case $state in
    cmd)
      _values 'subcommand' \
        'new[create a new worktree and branch, cd into it]' \
        'go[cd into an existing worktree]' \
        'ls[list all worktrees]' \
        'root[cd to the main worktree]' \
        'rm[remove a worktree and its branch]' \
        'done[remove the current worktree and its branch, return to root]' \
        'take[pull a worktree branch back into root]' \
        'send[move branch to worktree (from root), or to root (from worktree)]'
      ;;
    args)
      if [[ $words[2] == go || $words[2] == rm || $words[2] == take ]]; then
        local main
        main=$(_wt_main 2>/dev/null) || return
        local dir="$main/.worktrees"
        [[ -d "$dir" ]] && _values 'worktree' "$dir"/*(N:t)
      fi
      ;;
  esac
}

compdef _wt wt
