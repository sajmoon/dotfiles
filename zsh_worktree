# =============================================================================
# Git Worktree Helpers — wt
# =============================================================================
#
# A single `wt` command for managing git worktrees. Worktrees are created
# inside .worktrees/<name> at the repo root, and .worktrees/ is in
# gitignore_global so it won't pollute any repo's history.
#
# Subcommands:
#   wt new [name]    Create a worktree + NEW branch and cd into it.
#                    Omit name to get a timestamped throwaway: tmp-YYYYMMDDHHMMSS
#   wt get [-f] <branch>
#                    Adopt an EXISTING branch (e.g. one a cloud agent pushed).
#                    Fetches origin, then puts the branch in .worktrees/<branch
#                    with slashes flattened to dashes> and cds there. Idempotent:
#                    run it again later and it just cds in and fast-forwards.
#                    Refuses if the local branch has diverged from origin;
#                    -f/--force resets it to origin instead.
#   wt go <name>     cd into an existing worktree (you move, work stays).
#   wt ls            List all worktrees for the current repo.
#   wt root          cd to the main worktree (the original repo root).
#   wt rm [-f] <name|path>
#                    Remove worktree and force-delete its branch. Accepts a
#                    .worktrees/ name, an absolute/relative path, or any
#                    basename that uniquely identifies a worktree in the list.
#                    Pass -f/--force to remove a worktree with modified or
#                    untracked files. Branch is always force-deleted (-D) —
#                    worktree branches are typically unmerged by design.
#   wt done [-f]     From inside a worktree: cd to root, then remove the
#                    current worktree and force-delete its branch (same as
#                    `wt rm` on the worktree you're standing in). Use when
#                    you're finished with a worktree and want it gone.
#   wt clean [-y] [days] [--risky-days N]
#                    Remove stale worktrees. A worktree is stale when neither
#                    its branch nor its files have been touched for `days`
#                    (default 14); one holding uncommitted changes or unpushed
#                    commits gets a longer grace period (--risky-days, default
#                    days + 7). Worktrees a running process sits in are always
#                    kept. Prints a plan and removes nothing unless -y/--yes.
#   wt take <name>   From root: remove a named worktree and check out its
#                    branch here. Refuses if root has uncommitted changes.
#   wt send [name]   Dual-mode:
#                    • From root: move current branch to a new worktree, then
#                      return root to the default branch. Name defaults to the
#                      branch name. Refuses if root has uncommitted changes.
#                    • From a worktree: remove it and check out its branch in
#                      the main worktree (formerly "handoff").
#
# Tab completion:
#   wt <TAB>              → subcommands
#   wt go/rm/take <TAB>   → existing worktree names from .worktrees/
#   wt get <TAB>          → local and origin branch names
# =============================================================================

_wt_main() {
  git worktree list 2>/dev/null | awk 'NR==1 {print $1}'
}

_wt_root() {
  git rev-parse --show-toplevel 2>/dev/null
}

_wt_default_branch() {
  git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||' || echo main
}

# Path of the worktree that has branch $1 checked out, if any.
_wt_branch_worktree() {
  local branch="$1" wt_path="" line
  while IFS= read -r line; do
    case "$line" in
      worktree\ *) wt_path="${line#worktree }" ;;
      branch\ refs/heads/"$branch") print -r -- "$wt_path"; return 0 ;;
    esac
  done < <(git worktree list --porcelain)
  return 1
}

# Fast-forward the current worktree onto origin/<branch>, or report divergence.
_wt_sync() {
  local branch="$1" force="$2"
  local head_sha remote_sha base
  head_sha=$(git rev-parse HEAD) || return 1
  remote_sha=$(git rev-parse "origin/$branch") || return 1
  [[ "$head_sha" == "$remote_sha" ]] && return 0

  base=$(git merge-base HEAD "origin/$branch")
  if [[ "$base" == "$head_sha" ]]; then
    git merge --ff-only "origin/$branch"
  elif (( force )); then
    git reset --hard "origin/$branch"
  else
    echo "wt: local '$branch' has diverged from origin/$branch"
    echo "    commits here that origin does not have:"
    git --no-pager log --oneline "origin/$branch..HEAD" | sed 's/^/      /'
    echo "    re-run as 'wt get -f $branch' to discard them and reset to origin"
    return 1
  fi
}

# Age in whole days since the worktree was last touched: the newer of its
# last commit and the newest file mtime in the tree (.git excluded).
_wt_age_days() {
  local dir="$1" commit_ts file_ts newest
  commit_ts=$(git -C "$dir" log -1 --format=%ct 2>/dev/null)
  file_ts=$(find "$dir" -name .git -prune -o -type f -printf '%T@\n' 2>/dev/null \
    | sort -rn | head -1)
  file_ts="${file_ts%%.*}"
  newest=$(( commit_ts > file_ts ? commit_ts : file_ts ))
  print -r -- $(( ($(date +%s) - newest) / 86400 ))
}

# True if a running process has its cwd inside $1 — someone is standing in
# this worktree right now. Linux only; elsewhere the glob is empty and no
# worktree is ever reported as in use.
_wt_in_use() {
  local dir="$1" link cwd
  for link in /proc/[0-9]*/cwd(N); do
    cwd=$(readlink "$link" 2>/dev/null) || continue
    [[ "$cwd" == "$dir" || "$cwd" == "$dir"/* ]] && return 0
  done
  return 1
}

wt() {
  local cmd="$1"

  if [[ -z "$cmd" ]]; then
    echo "Usage: wt <new|get|go|ls|root|rm|clean|done|take|send> [name]"
    return 1
  fi

  case "$cmd" in

    new)
      local name="${2:-tmp-$(date +%Y%m%d%H%M%S)}"
      local main
      main=$(_wt_main) || { echo "wt: not inside a git repository"; return 1 }
      local dir="$main/.worktrees/$name"

      git worktree add -b "$name" "$dir" || return 1
      echo "→ $dir"
      cd "$dir"
      ;;

    get)
      local force=0
      shift
      while [[ "$1" == -* ]]; do
        case "$1" in
          -f|--force) force=1; shift ;;
          *) echo "wt get: unknown flag '$1'"; return 1 ;;
        esac
      done
      local branch="${1#refs/heads/}"
      branch="${branch#origin/}"
      if [[ -z "$branch" ]]; then
        echo "Usage: wt get [-f|--force] <branch>"
        return 1
      fi

      local main
      main=$(_wt_main) || { echo "wt: not inside a git repository"; return 1 }

      # Refresh the remote-tracking ref. Not fatal: the branch may be local-only.
      git fetch --quiet origin "+refs/heads/${branch}:refs/remotes/origin/${branch}" 2>/dev/null

      local has_local=0 has_remote=0
      git show-ref --verify --quiet "refs/heads/$branch" && has_local=1
      git show-ref --verify --quiet "refs/remotes/origin/$branch" && has_remote=1

      if (( ! has_local && ! has_remote )); then
        echo "wt: branch '$branch' not found locally or on origin"
        return 1
      fi

      # One worktree per branch: reuse the existing one, wherever it is.
      local dir
      dir=$(_wt_branch_worktree "$branch")
      if [[ -z "$dir" ]]; then
        dir="$main/.worktrees/${branch//\//-}"
        if [[ -e "$dir" ]]; then
          echo "wt: '$dir' exists but is not a worktree for '$branch'"
          return 1
        fi
        if (( has_local )); then
          git worktree add "$dir" "$branch" || return 1
        else
          git worktree add --track -b "$branch" "$dir" "origin/$branch" || return 1
        fi
      elif [[ "$dir" == "$main" ]]; then
        echo "wt: '$branch' is checked out in the main worktree"
      fi

      cd "$dir" || return 1
      echo "→ $dir"
      (( has_remote )) && _wt_sync "$branch" "$force"
      ;;

    go)
      local name="$2"
      if [[ -z "$name" ]]; then
        echo "Usage: wt go <name>"
        return 1
      fi

      local main
      main=$(_wt_main) || { echo "wt: not inside a git repository"; return 1 }
      local wt_dir="$main/.worktrees/$name"
      # Accept a branch name too: wt get flattens slashes to dashes.
      [[ ! -d "$wt_dir" ]] && wt_dir="$main/.worktrees/${name//\//-}"

      if [[ ! -d "$wt_dir" ]]; then
        echo "wt: worktree '$name' not found"
        return 1
      fi

      cd "$wt_dir"
      ;;

    ls)
      git worktree list
      ;;

    root)
      local main
      main=$(_wt_main) || { echo "wt: not inside a git repository"; return 1 }
      cd "$main"
      ;;

    rm)
      local force=0
      shift
      while [[ "$1" == -* ]]; do
        case "$1" in
          -f|--force) force=1; shift ;;
          *) echo "wt rm: unknown flag '$1'"; return 1 ;;
        esac
      done
      local arg="$1"
      if [[ -z "$arg" ]]; then
        echo "Usage: wt rm [-f|--force] <name|path>"
        return 1
      fi

      local main
      main=$(_wt_main) || { echo "wt: not inside a git repository"; return 1 }

      # Resolve arg → worktree path: try as path, then .worktrees/$arg, then basename match
      local target=""
      if [[ -d "$arg" ]]; then
        target=$(cd "$arg" && git rev-parse --show-toplevel 2>/dev/null)
      elif [[ -d "$main/.worktrees/$arg" ]]; then
        target="$main/.worktrees/$arg"
      else
        local matches=()
        local line p
        while IFS= read -r line; do
          p="${line%% *}"
          [[ "${p:t}" == "$arg" ]] && matches+=("$p")
        done < <(git worktree list)
        if [[ ${#matches[@]} -eq 0 ]]; then
          echo "wt: worktree '$arg' not found"
          return 1
        elif [[ ${#matches[@]} -gt 1 ]]; then
          echo "wt: '$arg' is ambiguous, matches:"
          printf '  %s\n' "${matches[@]}"
          return 1
        fi
        target="${matches[1]}"
      fi

      if [[ "$target" == "$main" ]]; then
        echo "wt: refusing to remove root worktree"
        return 1
      fi

      local branch
      branch=$(git -C "$target" rev-parse --abbrev-ref HEAD 2>/dev/null)

      local -a remove_args=(remove)
      (( force )) && remove_args+=(--force)
      remove_args+=("$target")
      git worktree "${remove_args[@]}" || return 1
      if [[ -n "$branch" && "$branch" != "HEAD" ]]; then
        git branch -D "$branch" 2>/dev/null
      fi
      ;;

    done)
      local force=0
      shift
      while [[ "$1" == -* ]]; do
        case "$1" in
          -f|--force) force=1; shift ;;
          *) echo "wt done: unknown flag '$1'"; return 1 ;;
        esac
      done

      local main
      main=$(_wt_main) || { echo "wt: not inside a git repository"; return 1 }
      local root
      root=$(_wt_root)

      if [[ "$root" != "$main/.worktrees/"* ]]; then
        echo "wt: not inside a worktree (use 'wt rm <name>' from root)"
        return 1
      fi

      local target="$root"
      local branch
      branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

      cd "$main" || return 1

      local -a remove_args=(remove)
      (( force )) && remove_args+=(--force)
      remove_args+=("$target")
      if ! git worktree "${remove_args[@]}"; then
        cd "$target"
        return 1
      fi
      if [[ -n "$branch" && "$branch" != "HEAD" ]]; then
        git branch -D "$branch" 2>/dev/null
      fi
      echo "→ done with '${target:t}', back at root"
      ;;

    clean)
      local yes=0 days=14 risky_days=""
      shift
      while [[ "$1" == -* ]]; do
        case "$1" in
          -y|--yes) yes=1; shift ;;
          --risky-days) risky_days="$2"; shift 2 ;;
          *) echo "wt clean: unknown flag '$1'"; return 1 ;;
        esac
      done
      [[ -n "$1" ]] && days="$1"
      : ${risky_days:=$(( days + 7 ))}

      local main
      main=$(_wt_main) || { echo "wt: not inside a git repository"; return 1 }
      git -C "$main" worktree prune

      local -a dirs doomed
      dirs=("$main"/.worktrees/*(N/))
      if (( ${#dirs} == 0 )); then
        echo "wt: no worktrees"
        return 0
      fi

      local dir name branch age dirty unpushed state action limit
      printf '%-28s %5s  %-22s %s\n' WORKTREE AGE STATE ACTION
      for dir in "${dirs[@]}"; do
        git -C "$dir" rev-parse --is-inside-work-tree &>/dev/null || continue
        name="${dir:t}"
        age=$(_wt_age_days "$dir")

        dirty=0
        [[ -n "$(git -C "$dir" status --porcelain)" ]] && dirty=1
        # Commits reachable from HEAD but from no remote-tracking ref: work
        # that exists only here.
        unpushed=$(git -C "$dir" rev-list --count HEAD --not --remotes 2>/dev/null)

        if (( dirty && unpushed )); then
          state="dirty, $unpushed unpushed"
        elif (( dirty )); then
          state="dirty"
        elif (( unpushed )); then
          state="$unpushed unpushed"
        else
          state="clean"
        fi

        limit=$(( dirty || unpushed ? risky_days : days ))
        if _wt_in_use "$dir"; then
          action="keep (in use)"
        elif (( age >= limit )); then
          action="REMOVE"
          doomed+=("$dir")
        else
          action="keep (< ${limit}d)"
        fi
        printf '%-28s %4dd  %-22s %s\n' "$name" "$age" "$state" "$action"
      done

      if (( ${#doomed} == 0 )); then
        echo
        echo "nothing to clean"
        return 0
      fi

      if (( ! yes )); then
        echo
        echo "dry run — nothing removed. Re-run as 'wt clean${1:+ $1} --yes' to remove ${#doomed} worktree(s)."
        return 0
      fi

      echo
      for dir in "${doomed[@]}"; do
        branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)
        git -C "$main" worktree remove --force "$dir" || continue
        if [[ -n "$branch" && "$branch" != "HEAD" ]]; then
          git -C "$main" branch -D "$branch" 2>/dev/null
        fi
      done
      echo "→ removed ${#doomed} worktree(s)"
      ;;

    take)
      local name="$2"
      if [[ -z "$name" ]]; then
        echo "Usage: wt take <name>"
        return 1
      fi

      local main
      main=$(_wt_main) || { echo "wt: not inside a git repository"; return 1 }
      local root
      root=$(_wt_root)

      if [[ "$root" != "$main" ]]; then
        echo "wt: must be run from the main worktree"
        return 1
      fi

      if [[ -n "$(git status --porcelain)" ]]; then
        echo "wt: uncommitted changes in root — stash or commit first"
        return 1
      fi

      local wt_dir="$main/.worktrees/$name"
      if [[ ! -d "$wt_dir" ]]; then
        echo "wt: worktree '$name' not found"
        return 1
      fi

      local branch
      branch=$(git -C "$wt_dir" rev-parse --abbrev-ref HEAD)

      git worktree remove "$wt_dir" || return 1
      git checkout "$branch"
      echo "→ took '$branch' into root"
      ;;

    send)
      local main
      main=$(_wt_main) || { echo "wt: not inside a git repository"; return 1 }
      local root
      root=$(_wt_root)

      if [[ "$root" == "$main/.worktrees/"* ]]; then
        # FROM WORKTREE → root
        local name="${root#$main/.worktrees/}"
        local branch
        branch=$(git rev-parse --abbrev-ref HEAD)

        cd "$main" || return 1
        git worktree remove "$main/.worktrees/$name" || return 1
        git checkout "$branch"
        echo "→ sent '$branch' to root"
      else
        # FROM ROOT → new worktree
        if [[ -n "$(git status --porcelain)" ]]; then
          echo "wt: uncommitted changes — stash or commit first"
          return 1
        fi

        local branch
        branch=$(git rev-parse --abbrev-ref HEAD)
        local name="${2:-$branch}"
        local wt_dir="$main/.worktrees/$name"
        local default_branch
        default_branch=$(_wt_default_branch)

        git checkout "$default_branch" || return 1
        git worktree add "$wt_dir" "$branch" || return 1
        echo "→ sent '$branch' to worktree, root is now on '$default_branch'"
      fi
      ;;

    *)
      echo "wt: unknown subcommand '$cmd'"
      echo "Usage: wt <new|get|go|ls|root|rm|clean|done|take|send> [name]"
      return 1
      ;;

  esac
}

# =============================================================================
# Agent harness integration (Claude Code, Codex)
# =============================================================================
# A worktree's git database lives in the MAIN repo at .git/worktrees/<name>,
# outside the worktree directory itself. So when an agent is launched from
# inside .worktrees/<name>, that worktree is its workspace root and nearly
# every git command (plus any read of the main checkout) reaches outside it —
# Claude Code prompts "allow access to this directory?" and Codex's sandbox
# escalates every write to the shared git metadata for approval.
#
# Both CLIs take --add-dir, so these transparent wrappers detect when the cwd
# is a *linked* worktree and pre-authorize the main worktree root, which
# covers both .git/worktrees/<name> and the main checkout. Keep typing
# `claude` / `codex` as usual.

# Print the main worktree root, only when cwd is inside a linked worktree.
_wt_linked_main() {
  local main top
  main=$(_wt_main)
  top=$(_wt_root)
  [[ -n "$main" && -n "$top" && "$main" != "$top" ]] && echo "$main"
}

claude() {
  local -a extra
  local main
  main=$(_wt_linked_main) && extra=(--add-dir "$main")
  command claude "${extra[@]}" "$@"
}

codex() {
  local -a extra
  local main
  main=$(_wt_linked_main) && extra=(--add-dir "$main")
  command codex "${extra[@]}" "$@"
}

# =============================================================================
# Completion
# =============================================================================

_wt() {
  local state
  _arguments \
    '1: :->cmd' \
    '*: :->args'

  case $state in
    cmd)
      _values 'subcommand' \
        'new[create a new worktree and branch, cd into it]' \
        'get[adopt an existing branch into a worktree, cd into it]' \
        'go[cd into an existing worktree]' \
        'ls[list all worktrees]' \
        'root[cd to the main worktree]' \
        'rm[remove a worktree and its branch]' \
        'clean[remove worktrees untouched for N days (dry run unless -y)]' \
        'done[remove the current worktree and its branch, return to root]' \
        'take[pull a worktree branch back into root]' \
        'send[move branch to worktree (from root), or to root (from worktree)]'
      ;;
    args)
      if [[ $words[2] == go || $words[2] == rm || $words[2] == take ]]; then
        local main
        main=$(_wt_main 2>/dev/null) || return
        local dir="$main/.worktrees"
        [[ -d "$dir" ]] && _values 'worktree' "$dir"/*(N:t)
      elif [[ $words[2] == get ]]; then
        local -a branches
        branches=(${(f)"$(git for-each-ref --format='%(refname:strip=2)' \
          refs/heads refs/remotes/origin 2>/dev/null)"})
        _values 'branch' ${branches:#HEAD}
      fi
      ;;
  esac
}

compdef _wt wt
